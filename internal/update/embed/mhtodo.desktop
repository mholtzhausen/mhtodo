[Desktop Entry]
Type=Application
Version=1.0
Name=mhtodo
GenericName=Todo Manager
Comment=Personal todo manager — board, activity, and archived views, scriptable CLI over the same data
Exec=mhtodo %u
TryExec=mhtodo
Icon=mhtodo
Terminal=false
Categories=Utility;
Keywords=todo;task;project;planner;
MimeType=x-scheme-handler/mhtodo;
StartupNotify=true
